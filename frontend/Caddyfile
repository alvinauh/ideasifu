# IdeaSifu web tier: serves the built SPA and reverse-proxies /api/* to the API
# container on the same origin (no CORS, works however the host is reached).
:80 {
	encode gzip

	# /api/* -> API container, with the /api prefix stripped so backend routes
	# stay at root (/generate-ideas, /more-ideas, /build, /refine, /health).
	handle_path /api/* {
		reverse_proxy ideasifu-api:8000
	}

	# Everything else: static SPA with client-side routing fallback.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server

		# index.html must never be cached — Cloudflare or browsers holding a
		# stale copy means users run old JS after a deploy.
		@html path *.html /
		header @html Cache-Control "no-store, must-revalidate"

		# Revalidate on every load — ETag gives a fast 304 if unchanged, but
		# forces a fresh download when content changes even if filename stays the same.
		@assets path *.js *.css *.woff2 *.woff *.ttf *.svg *.png *.ico
		header @assets Cache-Control "no-cache"
	}
}
